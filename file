local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end
local function root(player)
    local char = player and player.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart"))
end
local function countryTag(player)
    local tag = player:FindFirstChild("Country") or player:FindFirstChild("CountryTag")
    if tag and tag:IsA("StringValue") and tag.Value ~= "" then return tag.Value end
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            for _, billboard in ipairs(part:GetChildren()) do
                if billboard:IsA("BillboardGui") and billboard.Name ~= "CountryWatcherTag" then
                    for _, item in ipairs(billboard:GetDescendants()) do
                        if item:IsA("TextLabel") then
                            local text = trim(item.Text)
                            if #text >= 2 and #text <= 3 and text:upper() == text and text:match("^%u%u") then
                                return text
                            end
                        end
                    end
                end
            end
        end
    end
end
local function stopView()
    if viewConnection then viewConnection:Disconnect(); viewConnection = nil end
    viewing = nil
    local camera = workspace.CurrentCamera
    if camera then
        local char = localPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if humanoid then camera.CameraSubject = humanoid end
        camera.CameraType = Enum.CameraType.Custom
    end
    if updateControls then updateControls() end
end
local function startView(player)
    stopView()
    viewing = player
    viewConnection = RunService.RenderStepped:Connect(function()
        if not alive or player.Parent ~= Players then stopView(); return end
        local targetRoot, camera = root(player), workspace.CurrentCamera
        if targetRoot and camera then
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CFrame = CFrame.new(targetRoot.Position + Vector3.new(0, 8, 12), targetRoot.Position)
        end
    end)
    updateControls()
end
local function teleport(player)
    local mine, theirs = root(localPlayer), root(player)
    if mine and theirs then
        mine.CFrame = theirs.CFrame + theirs.CFrame.LookVector * 3 + Vector3.new(0, 2, 0)
        return true
    end
    return false
end


    accent = Color3.fromRGB(108, 226, 191), selected = Color3.fromRGB(34, 65, 66),
    red = Color3.fromRGB(255, 126, 143), amber = Color3.fromRGB(247, 196, 111),
}
local watchlist, listCount = {}, 0
local function trim(s) return s:match("^%s*(.-)%s*$") end
for line in DATA:gmatch("[^\r\n]+") do
    local id, country = trim(line):match("^(%d+)%s*:%s*(.+)$")
    if id then
        id, country = tonumber(id), trim(country:gsub("%s*%d+x%s*$", ""))
        if country ~= "" then
            if not watchlist[id] then listCount = listCount + 1 end
            watchlist[id] = country
        end
    end
end

local function make(class, props, parent)
    local object = Instance.new(class)
    for key, value in pairs(props) do object[key] = value end
    object.Parent = parent
    return object
end
local function round(object, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 10)}, object)
end
local function stroke(object, color)
    return make("UIStroke", {Color = color or theme.line, Thickness = 1}, object)
end
local function label(parent, text, size, position, textSize, color, bold)
    return make("TextLabel", {
        BackgroundTransparency = 1, Size = size, Position = position, Text = text,
        TextSize = textSize or 13, TextColor3 = color or theme.text,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, parent)
end


local function fitScreen()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local size = camera.ViewportSize
    scale.Scale = math.min(1, math.max(0.1, (size.X - 32) / 380), math.max(0.1, (size.Y - 48) / 530))
    -- Keep the header reachable after resizing and dragging.
    local width, height = 380 * scale.Scale, (collapsed and 66 or 530) * scale.Scale
    local pos = main.AbsolutePosition
    if pos.X < 0 or pos.Y < 0 or pos.X + width > size.X or pos.Y + height > size.Y then
        main.Position = UDim2.fromOffset(math.clamp(pos.X, 0, math.max(0, size.X - width)), math.clamp(pos.Y, 0, math.max(0, size.Y - height - 36)))
    end
end
local function cleanup()
    if not alive then return end
    alive = false; repeatTarget = nil
    if viewing then stopView() end
    for _, connection in ipairs(connections) do connection:Disconnect() end
    for player in pairs(entries) do removeEntry(player) end
    gui:Destroy()
end
connect(shutdown.Event, cleanup)
connect(close.Activated, cleanup)
connect(gui.Destroying, cleanup)

refreshList(); fitScreen()
task.spawn(function()
    local elapsed = 0
    while alive do
        task.wait(0.1)
        if not alive then break end
        if repeatTarget then
            if repeatTarget.Parent == Players then pcall(teleport, repeatTarget)
            else repeatTarget = nil; updateControls() end
        end
        elapsed = elapsed + 0.1
        if elapsed >= 1 then
            elapsed = 0
            fitScreen()
            for player, entry in pairs(entries) do
                local ok, tag = pcall(countryTag, player)
                tag = ok and tag or nil
                entry.tagLabel.Text = watchlist[player.UserId] .. (tag and (" | " .. tag) or " (?)")
                entry.tagLabel.TextColor3 = not tag and theme.accent
                    or (tag:upper() == watchlist[player.UserId]:upper() and theme.accent or theme.red)
            end
            refreshList()
        end
    end
end)

updateControls = function()
    local valid = selected and selected.Parent == Players
    selection.Text = valid and (selected.DisplayName .. "  @" .. selected.Name) or "Select a player to begin"
    status.Text = repeatTarget and ("Repeating teleport to @" .. repeatTarget.Name)
        or viewing and ("Viewing @" .. viewing.Name)
        or valid and watchlist[selected.UserId] or "Choose a card above to unlock actions"
    tpButton.TextColor3 = valid and theme.accent or theme.muted
    viewButton.TextColor3 = (valid or viewing) and theme.text or theme.muted
    viewButton.Text = viewing and "Stop view" or "View"
    repeatButton.Text = repeatTarget and "Repeat teleport  ·  ON" or "Repeat teleport  ·  OFF"
    repeatButton.BackgroundColor3 = repeatTarget and theme.selected or theme.card
    repeatButton.TextColor3 = repeatTarget and theme.accent or theme.muted
    for player, entry in pairs(entries) do
        entry.row.BackgroundColor3 = player == selected and theme.selected or theme.card
        entry.outline.Color = player == selected and theme.accent or theme.line
    end
end
local function removeEntry(player)
    local entry = entries[player]
    if not entry then return end
    if entry.respawn then entry.respawn:Disconnect() end
    if entry.click then entry.click:Disconnect() end
    entry.holder:Destroy(); entry.row:Destroy()
    entries[player] = nil
end
local function addEntry(player)
    if player == localPlayer or not watchlist[player.UserId] or entries[player] then return end
    local row = button(scroll, "", UDim2.new(1, 0, 0, 70), UDim2.new())
    local outline = stroke(row)
    local avatar = label(row, player.DisplayName:sub(1, 1):upper(), UDim2.fromOffset(36, 36), UDim2.fromOffset(12, 17), 16, theme.accent, true)
    avatar.BackgroundTransparency = 0; avatar.BackgroundColor3 = theme.selected
    avatar.TextXAlignment = Enum.TextXAlignment.Center; round(avatar, 10)
    local name = label(row, "", UDim2.new(1, -68, 0, 21), UDim2.fromOffset(60, 9), 13, theme.text, true)
    local username = label(row, "", UDim2.new(1, -68, 0, 16), UDim2.fromOffset(60, 29), 10, theme.muted)
    label(row, watchlist[player.UserId], UDim2.new(1, -68, 0, 17), UDim2.fromOffset(60, 46), 11, theme.accent)
    local holder = make("BillboardGui", {
        Name = "CountryWatcherTag", Size = UDim2.fromOffset(240, 32),
        StudsOffset = Vector3.new(0, 3.2, 0), AlwaysOnTop = true, MaxDistance = 1000,
    }, gui)
    local tagLabel = label(holder, watchlist[player.UserId] .. " (?)", UDim2.fromScale(1, 1), UDim2.new(), 13, theme.accent, true)
    tagLabel.TextXAlignment = Enum.TextXAlignment.Center; tagLabel.TextStrokeTransparency = 0.3
    local entry = {row = row, outline = outline, holder = holder, tagLabel = tagLabel, name = name, username = username}
    entries[player] = entry
    -- Keep the billboard outside the character so respawns cannot destroy it.
    local function attach(char)
        holder.Adornee = nil
        task.spawn(function()
            local deadline = os.clock() + 10
            repeat
                if not alive or entries[player] ~= entry or player.Character ~= char then return end
                local head = char:FindFirstChild("Head") or char:FindFirstChildWhichIsA("BasePart")
                if head then holder.Adornee = head; return end
                task.wait(0.1)
            until os.clock() >= deadline
        end)
    end
    entry.respawn = player.CharacterAdded:Connect(attach)
    if player.Character then attach(player.Character) end
    entry.click = row.Activated:Connect(function() selected = player; updateControls() end)
end
refreshList = function(excluded)
    for player in pairs(entries) do
        if player == excluded or player.Parent ~= Players then removeEntry(player) end
    end
    local players = Players:GetPlayers()
    table.sort(players, function(a, b)
        local an, bn = a.DisplayName:lower(), b.DisplayName:lower()
        if an == bn then return a.UserId < b.UserId end
        return an < bn
    end)
    local query, total, visible = search.Text:lower(), 0, 0
    for order, player in ipairs(players) do
        if player ~= excluded then addEntry(player) end
        local entry = entries[player]
        if entry then
            total = total + 1
            entry.row.LayoutOrder = order
            entry.name.Text = player.DisplayName
            entry.username.Text = "@" .. player.Name
            local haystack = (player.DisplayName .. " " .. player.Name .. " " .. watchlist[player.UserId]):lower()
            entry.row.Visible = query == "" or haystack:find(query, 1, true) ~= nil
            if entry.row.Visible then visible = visible + 1 end
        end
    end
    countLabel.Text = total .. " online  /  " .. listCount .. " on your watchlist"
    empty.Visible = visible == 0
    empty.Text = total == 0 and "No tracked players in this server.\nYour watchlist is ready for new arrivals." or "No players match your search."
    updateControls()
end


local gui = make("ScreenGui", {
    Name = "CountryWatcherGui", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    DisplayOrder = 50,
})
local parent = playerGui
pcall(function() gui.Parent = game:GetService("CoreGui") end)
if gui.Parent then parent = gui.Parent else gui.Parent = playerGui end
for _, old in ipairs(parent:GetChildren()) do
    if old ~= gui and old.Name == gui.Name and old:IsA("ScreenGui") then
        local shutdown = old:FindFirstChild("Shutdown")
        if shutdown and shutdown:IsA("BindableEvent") then shutdown:Fire() end
        old:Destroy()
    end
end
local shutdown = make("BindableEvent", {Name = "Shutdown"}, gui)
